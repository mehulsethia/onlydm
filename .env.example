# RevenueCat public SDK keys (Project settings > API keys). Leave blank for dev mode (everything unlocked).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# The marketing site (site/), e.g. https://www.getonlydm.com. Privacy and Terms in the app link to its /privacy/ and /terms/.
EXPO_PUBLIC_SITE_URL=
# Defaults to https://www.getonlydm.com when blank. Optional overrides for the legal pages:
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Milestone 5: where newer rules packs are hosted.
RULES_BASE_URL=
