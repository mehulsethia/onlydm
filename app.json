{
  "expo": {
    "name": "OnlyDM",
    "slug": "onlydm",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "onlydm",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.onlydm.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "OnlyDM uses the camera so you can take a photo to send in a message.",
        "NSMicrophoneUsageDescription": "OnlyDM uses the microphone so you can record voice notes and video messages.",
        "NSPhotoLibraryUsageDescription": "OnlyDM lets you choose photos and videos to send in a message.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.onlydm.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./public/favicon-48x48.png",
      "name": "OnlyDM",
      "shortName": "OnlyDM",
      "backgroundColor": "#0A0A0A",
      "themeColor": "#0A0A0A"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc311ba9-3be8-4533-9c38-9c7951ab3256"
      }
    },
    "owner": "kaizen-ventures"
  }
}
